# =============================================================================
# VARIÁVEIS DE AMBIENTE - Plataforma de Dados Local
# =============================================================================
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
#
# ATENÇÃO: Nunca suba o arquivo .env para o Git!
# O .env.example (com valores fictícios) é seguro para versionar.
# =============================================================================

# -----------------------------------------------------------------------------
# POSTGRESQL (simula o Amazon Redshift localmente)
# No AWS real: seria o endpoint do cluster Redshift
# Ex: meu-cluster.abc123.us-east-1.redshift.amazonaws.com
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dataplatform
POSTGRES_USER=dataplatform_user
POSTGRES_PASSWORD=dataplatform_pass123

# -----------------------------------------------------------------------------
# AIRFLOW - Orquestrador de pipelines
# No AWS real: seria o MWAA (Managed Workflows for Apache Airflow)
# -----------------------------------------------------------------------------
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://dataplatform_user:dataplatform_pass123@postgres:5432/airflow_db
AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
AIRFLOW__WEBSERVER__SECRET_KEY=minha_chave_secreta_airflow_123
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin123

# -----------------------------------------------------------------------------
# KAFKA (simula o Amazon Kinesis localmente)
# No AWS real: seria o endpoint do Kinesis stream
# Ex: kinesis.us-east-1.amazonaws.com
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_TOPIC_EVENTOS=eventos-website
KAFKA_TOPIC_VENDAS=eventos-vendas
KAFKA_CONSUMER_GROUP=data-platform-consumers

# -----------------------------------------------------------------------------
# S3 LOCAL (simula o Amazon S3)
# No AWS real: seria o nome do bucket S3
# Ex: s3://minha-empresa-data-lake/raw/clientes/
# -----------------------------------------------------------------------------
S3_BASE_PATH=./s3
S3_RAW_PATH=./s3/raw
S3_PROCESSED_PATH=./s3/processed
S3_ARCHIVED_PATH=./s3/archived

# Configurações de lifecycle (quantos dias até arquivar)
S3_ARCHIVE_AFTER_DAYS=90
S3_DELETE_AFTER_DAYS=365

# -----------------------------------------------------------------------------
# AWS CREDENTIALS (para uso com boto3 - aponta para LocalStack ou mock)
# No AWS real: seria suas credenciais IAM reais
# NUNCA coloque credenciais AWS reais aqui em texto plano!
# Use AWS CLI: aws configure
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=local_fake_access_key
AWS_SECRET_ACCESS_KEY=local_fake_secret_key
AWS_DEFAULT_REGION=us-east-1
# Descomente se usar LocalStack (emulador AWS local):
# AWS_ENDPOINT_URL=http://localhost:4566

# -----------------------------------------------------------------------------
# AIRBYTE - Ferramenta de ingestão de dados
# No AWS real: seria substituído por AWS DMS ou Glue Connectors
# -----------------------------------------------------------------------------
AIRBYTE_API_URL=http://localhost:8001
AIRBYTE_USERNAME=airbyte
AIRBYTE_PASSWORD=password

# -----------------------------------------------------------------------------
# PGADMIN - Interface visual para PostgreSQL
# Acesse em: http://localhost:5050
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@dataplatform.com
PGADMIN_PASSWORD=pgadmin123

# -----------------------------------------------------------------------------
# FONTE DE DADOS CRM (banco PostgreSQL que simula o CRM da empresa)
# No AWS real: seria o banco de dados de origem conectado via DMS
# -----------------------------------------------------------------------------
CRM_DB_HOST=postgres
CRM_DB_PORT=5432
CRM_DB_NAME=crm_source
CRM_DB_USER=crm_user
CRM_DB_PASSWORD=crm_pass123

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DO PIPELINE
# -----------------------------------------------------------------------------
# Ambiente: development, staging, production
ENVIRONMENT=development

# Número de linhas para gerar nos dados de exemplo
SAMPLE_DATA_CLIENTES=1000
SAMPLE_DATA_VENDAS=5000
SAMPLE_DATA_EVENTOS=10000

# Timezone do Brasil
TZ=America/Sao_Paulo
AIRFLOW__CORE__DEFAULT_TIMEZONE=America/Sao_Paulo

# -----------------------------------------------------------------------------
# MONITORAMENTO E ALERTAS
# No AWS real: seria CloudWatch + SNS para notificações
# -----------------------------------------------------------------------------
ALERT_EMAIL=alertas@minha-empresa.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/FAKE/WEBHOOK/URL

# Limites para alertas
ALERT_MIN_ROWS_CLIENTES=100
ALERT_MIN_ROWS_VENDAS=50
ALERT_MAX_PIPELINE_DURATION_MINUTES=60
