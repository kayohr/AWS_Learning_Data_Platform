{
  "expectation_suite_name": "vendas_raw_suite",
  "meta": {
    "descricao": "Regras de qualidade para dados de vendas",
    "responsavel": "time-dados"
  },
  "expectations": [
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "id_venda"}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "valor_total"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "valor_total", "mostly": 0.99}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "valor_total",
        "min_value": 0.01,
        "max_value": 500000,
        "mostly": 0.99
      },
      "_comentario": "Vendas entre R$0,01 e R$500.000 (valores extremos são suspeitos)"
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "canal_venda",
        "value_set": ["LOJA_FISICA", "ECOMMERCE", "TELEVENDAS", "APP_MOBILE"],
        "mostly": 0.99
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "status_venda",
        "value_set": ["CONCLUIDA", "CANCELADA", "DEVOLVIDA", "PENDENTE"],
        "mostly": 0.99
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "quantidade",
        "min_value": 1,
        "max_value": 1000,
        "mostly": 0.99
      },
      "_comentario": "Quantidade entre 1 e 1000 itens"
    },
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {"min_value": 1, "max_value": 10000000}
    }
  ]
}
